---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  isActive: boolean;
}

const { isActive, href } = Astro.props;
---

<a
  data-is-active={isActive}
  class="hover:text-mocha-pink underline transition-colors data-[is-active=true]:font-bold"
  href={href}><slot /></a
>
