---
import LinkedInIcon from "../assets/svgs/linkedin.svg";
import GitHubIcon from "../assets/svgs/github.svg";
import SocialLink from "./SocialLink.astro";

const links = [
  {
    text: "LinkedIn",
    IconComponent: LinkedInIcon,
    href: "https://www.linkedin.com/in/francisko-rezende/",
  },
  {
    text: "GitHub",
    IconComponent: GitHubIcon,
    href: "https://github.com/francisko-rezende",
  },
];
---

<footer class="mx-auto flex w-full max-w-3xl justify-between border-t p-4">
  <ul class="flex w-full justify-end gap-4">
    {
      links.map(({ href, IconComponent, text }) => {
        return (
          <li>
            <SocialLink href={href}>
              <IconComponent />
              <span class="sr-only">{text}</span>
            </SocialLink>
          </li>
        );
      })
    }
  </ul>
</footer>
